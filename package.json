{
  "name": "glorysuperagent",
  "repository": "github:qq2814703211-glitch/GlorySuperAgent",
  "author": "GlorySuperAgent contributors",
  "contributors": [
    "DeepSeek Harness Team <team@dsh.dev>"
  ],
  "license": "MIT",
  "version": "0.0.1",
  "private": true,
  "description": "GlorySuperAgent runs authorized coding requests from GitHub and chat in dedicated workspaces, standalone or inside DeepSeek Harness.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "glorysuperagent": "./scripts/glorysuperagent.mjs",
    "superagent": "./scripts/glorysuperagent.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./github-watch": "./lib/github-watch.js",
    "./feishu-watch": "./lib/feishu-watch.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "desktop/dist",
    "scripts/glorysuperagent.mjs",
    "scripts/superagent.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "prompts",
    "skills"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1
  },
  "scripts": {
    "build": "tsdown && pnpm ui:build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "start": "electron desktop/main.mjs",
    "desktop:package": "pnpm ui:build && node desktop/package.mjs",
    "ui:dev": "vite --config desktop/vite.config.ts",
    "ui:build": "vite build --config desktop/vite.config.ts",
    "desktop:installer": "pnpm ui:build && node desktop/installer.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "^0.2.1-alpha.2"
  },
  "packageManager": "pnpm@11.7.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "proper-lockfile": "4.1.2",
    "yaml": "2.9.1",
